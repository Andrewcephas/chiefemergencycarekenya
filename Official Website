<script>
/* Carousel with improved accessibility and reduced-motion respect */
(function(){
  const slides = Array.from(document.querySelectorAll('.slide'));
  const dotsBox = document.querySelector('.dots');
  let idx = 0;
  let timer = null;
  const prefersReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // create dots with accessible attributes
  slides.forEach((_, n) => {
    const b = document.createElement('button');
    b.type = 'button';
    b.setAttribute('aria-label', 'Slide ' + (n + 1));
    b.setAttribute('role','tab');
    b.setAttribute('aria-selected','false');
    b.addEventListener('click', () => { show(n); restart(); });
    dotsBox.appendChild(b);
  });
  const dots = Array.from(dotsBox.querySelectorAll('button'));

  function setAriaForSlide(i, active) {
    const s = slides[i];
    s.classList.toggle('active', active);
    s.setAttribute('aria-hidden', String(!active));
    dots[i].classList.toggle('active', active);
    dots[i].setAttribute('aria-pressed', String(active));
    dots[i].setAttribute('aria-selected', String(active));
    if (active) dots[i].setAttribute('aria-current','true'); else dots[i].removeAttribute('aria-current');
  }

  function show(n) {
    if (n < 0) n = slides.length - 1;
    if (n >= slides.length) n = 0;
    setAriaForSlide(idx, false);
    idx = n;
    setAriaForSlide(idx, true);
  }

  function next() { show((idx + 1) % slides.length); }

  function restart() {
    if (timer) clearInterval(timer);
    if (prefersReduce) return;
    timer = setInterval(next, 5000);
  }

  // Pause auto-advance on user interaction
  const hero = document.querySelector('.hero');
  hero.addEventListener('mouseenter', () => clearInterval(timer));
  hero.addEventListener('focusin', () => clearInterval(timer));
  hero.addEventListener('mouseleave', () => restart());
  hero.addEventListener('focusout', () => restart());

  // Keyboard controls: left/right arrows to navigate
  hero.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') { show(idx - 1); restart(); }
    if (e.key === 'ArrowRight') { show(idx + 1); restart(); }
  });

  // Initialize
  show(0);
  restart();

  // Improve slide semantics for screen readers: keep role labels from data attribute (already set in markup)
})();

/* Contact form: compose mailto for simple fallback.
   Use form fields and validate basic presence - the browser still enforces required.
*/
document.getElementById('contactForm').addEventListener('submit', function(e){
  e.preventDefault();
  const v = id => (document.getElementById(id) || {}).value || '';
  const subject = 'Website enquiry: ' + v('f-interest');
  const body = 'Name: ' + v('f-name') + '\nEmail: ' + v('f-email') + '\nPhone: ' + v('f-phone') + '\n\n' + v('f-message');
  // mailto fallback - user agent will open default mail client
  window.location.href = 'mailto:chiefemergencycare@gmail.com?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
});
</script>
