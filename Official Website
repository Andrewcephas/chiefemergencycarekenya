footer{background:#0d1730;color:#cfd6e4;text-align:center;padding:28px 20px;font-size:.9rem}
.sr-only{position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden}
button:focus, a:focus, input:focus, select:focus, textarea:focus{outline:3px solid rgba(255,255,255,.12);outline-offset:2px}
